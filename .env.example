# คัดลอกไฟล์นี้เป็น .env ก่อนรัน:  cp .env.example .env
# (ไฟล์ .env ถูก .gitignore ไว้ ห้าม commit รหัสผ่านจริง)

# Linux ให้ใส่ผลของคำสั่ง id -u ส่วน macOS/Windows ใช้ 50000 ได้
AIRFLOW_UID=50000

# ผู้ใช้สำหรับเข้า Airflow UI (http://localhost:8080)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me

# Postgres สำหรับ metadata ของ Airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_me

# Postgres ปลายทางเก็บข้อมูล (dashboard อ่านจากที่นี่โดยตรง)
TARGET_DB_NAME=kupop
TARGET_DB_USER=kupop
TARGET_DB_PASSWORD=change_me
TARGET_DB_PORT=5434
